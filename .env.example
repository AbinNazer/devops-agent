# Copy this file to .env and replace placeholder values.
# Never commit .env or real credentials.

# Authentication and database
DATABASE_ENABLED=false
DATABASE_URL=postgresql://jarvis:REPLACE_PASSWORD@127.0.0.1:5432/jarvis
ENCRYPTION_KEY=REPLACE_WITH_A_FERNET_KEY
JARVIS_WEB_USERNAME=REPLACE_USERNAME
JARVIS_WEB_PASSWORD=REPLACE_STRONG_PASSWORD
JARVIS_COOKIE_SECURE=false
JARVIS_EMAIL_VERIFICATION_REQUIRED=false

# Browser origins. Use the exact URL users open in the browser.
JARVIS_ALLOWED_ORIGINS=http://127.0.0.1:8001,http://localhost:8001
JARVIS_LOGIN_RATE_LIMIT=10
JARVIS_LOGIN_RATE_WINDOW_SECONDS=300

# LLM provider and failover
LLM_PROVIDER=groq
EMBEDDING_PROVIDER=hashing
LLM_FALLBACK_PROVIDERS=openai,gemini,openrouter,nvidia
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OmniRoute local gateway example: http://127.0.0.1:20128/v1
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

# Execution mode: ssh for laptop -> VPS, local for the VPS itself
EXECUTION_MODE=ssh
VPS_HOST=REPLACE_VPS_IP_OR_HOSTNAME
VPS_SSH_USER=REPLACE_SSH_USER
VPS_SSH_PORT=22
VPS_SSH_KEY_PATH=~/.ssh/id_ed25519
VPS_KNOWN_HOSTS_PATH=~/.ssh/known_hosts

# Optional infrastructure integrations
JENKINS_CONTAINER_NAME=jenkins
AWS_REGION=
AWS_DEFAULT_REGION=
PROMETHEUS_PORT=

# Voice is disabled by default
VOICE_ENABLED=false
STT_PROVIDER=whisper
TTS_PROVIDER=kokoro
KOKORO_VOICE=am_michael
WHISPER_MODEL=base

# Worker/control plane
WORKER_ENABLED=true
WORKER_CONTROL_PLANE_URL=http://127.0.0.1:8001
WORKER_ID=
WORKER_ENROLLMENT_TOKEN=

# Tool Factory remote search: comma-separated absolute roots the LLM may
# search read-only (grep/find/tail are whitelisted per root at startup).
# Leave empty to disable remote search entirely. Paths under these roots are
# scanned with secret redaction; .env and credential files are never returned.
JARVIS_SEARCH_ALLOWED_ROOTS=

# Local Ollama option
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Personality (optional) ---
# Preset: DEFAULT_JARVIS (default), PROFESSIONAL, CASUAL, KASI, MINIMAL, INCIDENT_MODE
# DEFAULT_JARVIS = witty + light SA street seasoning; KASI = full street flavor
JARVIS_PERSONALITY_PRESET=DEFAULT_JARVIS
# Set false to disable the personality layer entirely (default voice only)
JARVIS_PERSONALITY_ENABLED=true
